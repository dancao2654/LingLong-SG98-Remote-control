{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PlatformIO: Build SG98 Universal Controller Firmware",
      "type": "process",
      "command": "platformio",
      "windows": {
        "command": "${env:USERPROFILE}\\.platformio\\penv\\Scripts\\platformio.exe"
      },
      "osx": {
        "command": "${env:HOME}/.platformio/penv/bin/platformio"
      },
      "linux": {
        "command": "${env:HOME}/.platformio/penv/bin/platformio"
      },
      "args": [
        "run",
        "-e",
        "controller-universal-s3"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$platformio"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
